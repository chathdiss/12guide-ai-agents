# Port the server listens on. Render sets this itself; locally it defaults to 4000.
PORT=4000

# Production URL of the Advisor chat webhook in n8n (the Webhook node shows it once the workflow is Active)
N8N_CHAT_URL=http://localhost:5678/webhook/advisor-chat

# Secret shared with n8n, sent in the X-Internal-Key header. The Webhook node in n8n uses
# Header Auth with the same value. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=

# Optional
RATE_LIMIT_PER_MINUTE=30
AGENT_TIMEOUT_MS=120000
